<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>UrlShortener.Orchestrator</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Microsoft.NET.Sdk's implicit usings do not include System.Threading (only Sdk.Web's do),
         but CancellationToken/SemaphoreSlim/Interlocked are used throughout the engine. -->
    <Using Include="System.Threading" />
  </ItemGroup>
</Project>
